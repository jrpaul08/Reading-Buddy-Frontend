# Reading Buddy backend endpoints (Modal). URLs are safe to expose in the
# client; save/list/position require a Clerk token or guest session_id.
VITE_S2S_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-s2s-endpoint.modal.run
VITE_WARMUP_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-warmup--123417.modal.run
VITE_SAVE_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-save-re-58e1da.modal.run
VITE_LIST_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-list-sa-5d5a88.modal.run
VITE_GLOSSARY_ADD_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-add-to--c3fa89.modal.run
VITE_GLOSSARY_LIST_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-list-gl-2a3e88.modal.run
VITE_SAVE_POSITION_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-save-re-c0e8b9.modal.run
VITE_GET_POSITION_URL=https://pauljared48--reading-buddy-pipeline-orchestrator-get-rea-d71064.modal.run

# Production builds (Vercel) read the same keys from .env.production.
# Optional: set these in Vercel → Settings → Environment Variables to override.

# Clerk publishable key (frontend). Create an application at
# https://dashboard.clerk.com and allow http://localhost:5173 plus your
# Vercel origin. Never put the secret key in this app.
VITE_CLERK_PUBLISHABLE_KEY=

# Set to "1" to use a local echo mock instead of calling Modal (no GPU cost).
VITE_MOCK=0
